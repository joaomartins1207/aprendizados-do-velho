# ==========================================
# VARIÁVEIS DE AMBIENTE - APRENDIZADOS DO VELHO
# Configure estas variáveis no painel da Vercel (Project Settings > Environment Variables)
# ==========================================

# 1. Banco de Dados PostgreSQL (Crie gratuitamente em https://neon.tech)
# Use a Connection string com pooling fornecida pelo Neon
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Connection string direta (sem pgbouncer) para migrações Prisma
DIRECT_URL="postgresql://usuario:senha@ep-exemplo.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Mercado Pago (Produção)
# Obtenha em https://www.mercadopago.com.br/developers/panel/app
PIX_ACCESS_TOKEN="APP_USR-seu-token-aqui"
PIX_WEBHOOK_SECRET="seu-segredo-de-webhook"

# 3. Envio de E-mails (Resend - Gratuito em https://resend.com)
EMAIL_API_KEY="re_sua_chave_resend"
EMAIL_FROM="Aprendizados do Velho <contato@seudominio.com.br>"

# 4. URL do seu site com domínio final (sem barra no final)
# Exemplo: https://aprendizadosdovelho.com.br
NEXT_PUBLIC_SITE_URL="https://seudominio.com.br"

# 5. Link público do PDF do e-book (Google Drive, Cloudflare R2, AWS S3, etc.)
# No Google Drive: clique com botão direito no PDF > Compartilhar > Qualquer pessoa com o link > Copiar link direto
BOOK_PDF_URL="https://sua-url-do-pdf-hospedado.com/aprendizados-do-velho.pdf"
